{
  "scripts": {
    "dev:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/main.css --watch",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/main.css --minify",
    "lighthouse": "lhci autorun",
    "lighthouse:smoke": "lhci autorun --config=lighthouserc.smoke.json",
    "carbon": "carbon-now-cli --config carbon.json --preset blog"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15",
    "@tailwindcss/cli": "^4.3.3",
    "carbon-now-cli": "^2.1.0",
    "tailwindcss": "^4.3.1"
  }
}
